/*
 * Master.json - Universal Framework for Project Excellence
 * 
 * A question-driven methodology that ensures quality in any project.
 * Applied automatically by LLM to all code, projects, and ideas.
 * 
 * Core Principles:
 * - Think deeply before acting
 * - Ask why before how
 * - Build once, correctly
 * - Simplicity over complexity
 * 
 * Features:
 * - 5-phase workflow (Analyze → Design → Implement → Validate → Deliver)
 * - Multi-perspective validation (Architecture, Security, User, Performance, Devil's Advocate)
 * - Adaptive execution modes (Standard, Hotfix, Maintenance, Exploration, Review)
 * - Language-specific formatting (Ruby/Rails, Shell, Web, Config)
 * - Quality gates between phases
 * - Universal patterns: Idempotency, Atomicity, Observability, Reversibility, Least Privilege
 * 
 * Version: 131.0.0
 * Frozen: 2024-01-10
 */

{
  "name": "master.json",
  "version": "131.0.0-complete",
  "purpose": "Universal question-driven framework with cognitive protection and multi-perspective validation",
  "frozen": "2024-01-10T00:00:00Z",

  "cognitive_core": {
    /* ⚠️ NEVER REMOVE - Essential reasoning. Survives all future versions */
    /* Core that ensures framework integrity and quality regardless of changes */
    "essential_methodology": {
      "questions_before_solutions": "Always ask why before how",
      "evidence_required": "Every claim needs justification",
      "multi_perspective": "Validate from multiple viewpoints",
      "fail_safe": "When in doubt, fall back to core principles",
      "preserve_working": "Never break what already works"
    },
    "protected_elements": [
      "questions",
      "workflow.phases",
      "patterns.universal",
      "guides.red_flags",
      "meta.mantras"
    ],
    "validation_loop": "question → analyze → implement → validate → deliver → iterate"
  },

  "core": {
    "philosophy": "Think deeply before acting. Question everything. Build once, correctly.",
    "entry_point": "When user presents any project/code/idea → apply all framework phases systematically",
    "execution": "Read entire project → Ask questions from each category → Guide through workflow → Validate quality gates",
    "adaptability": "Use contextual reasoning to understand project type from structure, patterns, conventions, and purpose rather than file extensions"
  },

  "questions": {
    "purpose": [
      "What specific problem does this solve?",
      "Who experiences this problem and how often?",
      "What's the measurable impact of solving it?",
      "What happens if we don't solve it?"
    ],
    "context": [
      "What constraints are we working within?",
      "What existing systems must we integrate with?",
      "What technical debt are we inheriting?",
      "What resources do we realistically have?"
    ],
    "approach": [
      "What's the simplest solution that could work?",
      "Where are the likely failure points?",
      "How will we know if it's working?",
      "What's our rollback plan?"
    ],
    "quality": [
      "Can someone else understand and maintain this?",
      "Have we handled all error cases?",
      "Is this the minimum complexity needed?",
      "Would we be proud to sign our name to this?"
    ]
  },

  "workflow": {
    "instructions": "LLM selects appropriate execution mode based on context. Default to standard for new work.",
    "iteration": "After delivery, return to phase 1 with new knowledge. Keep what works, change what doesn't.",
    "flexibility": "Phases are guidelines. Skip or compress based on execution mode and context.",
    "phases": [
      {
        "id": "1_analyze",
        "goal": "Understand completely before starting",
        "actions": [
          "Map all dependencies and constraints",
          "Identify stakeholders and their needs",
          "Document existing state thoroughly",
          "Define clear success criteria"
        ],
        "complete_when": "Can explain problem in one sentence, know all constraints, have measurable success criteria",
        "output": "Problem statement with specific, measurable goals"
      },
      {
        "id": "2_design",
        "goal": "Find the optimal approach",
        "actions": [
          "Generate multiple solution options",
          "Evaluate trade-offs honestly",
          "Choose simplest viable approach",
          "Plan for failure and edge cases"
        ],
        "complete_when": "Have compared 3+ approaches, identified all failure modes, chosen simplest solution",
        "output": "Design document with approach, trade-offs, and risk mitigation"
      },
      {
        "id": "3_implement",
        "goal": "Build correctly the first time",
        "actions": [
          "Write clean, self-documenting code",
          "Handle errors at every level",
          "Add instrumentation and logging",
          "Create rollback points"
        ],
        "complete_when": "Code handles all edge cases, errors are caught and logged, can rollback if needed",
        "output": "Working solution with operational visibility"
      },
      {
        "id": "4_validate",
        "goal": "Prove it works as intended",
        "actions": [
          "Test all paths including failures",
          "Verify security boundaries",
          "Measure performance impact",
          "Confirm user acceptance"
        ],
        "complete_when": "All tests pass, security validated, performance acceptable, users approve",
        "output": "Test results, security audit, performance metrics, user feedback"
      },
      {
        "id": "5_deliver",
        "goal": "Hand off successfully",
        "actions": [
          "Document for operators and users",
          "Set up monitoring and alerts",
          "Train stakeholders",
          "Archive decisions and learnings"
        ],
        "complete_when": "Documentation complete, monitoring active, users trained, handoff accepted",
        "output": "Production system with documentation, monitoring, and trained operators"
      }
    ]
  },

  "patterns": {
    "universal": {
      "idempotency": "Same operation multiple times = same result",
      "atomicity": "All or nothing, no partial states",
      "observability": "Always know what's happening and why",
      "reversibility": "Can undo or roll back any change",
      "least_privilege": "Minimal permissions for each component"
    },
    "by_context": {
      "shell_scripts": {
        "emphasize": ["error_handling", "state_preservation", "idempotency"],
        "require": ["error trapping", "state tracking", "progress logging", "cleanup handlers"]
      },
      "web_services": {
        "emphasize": ["security", "performance", "availability"],
        "require": ["authentication layer", "input validation", "error handling", "health monitoring"]
      },
      "system_tools": {
        "emphasize": ["correctness", "efficiency", "composability"],
        "require": ["documentation", "exit codes", "stream handling", "signal management"]
      },
      "data_processing": {
        "emphasize": ["accuracy", "completeness", "reproducibility"],
        "require": ["validation", "quality checks", "audit trail", "recovery points"]
      },
      "user_applications": {
        "emphasize": ["user_experience", "responsiveness", "reliability"],
        "require": ["interface design", "error recovery", "performance monitoring", "platform compliance"]
      }
    }
  },

  "formatting": {
    "universal": {
      "indentation": "2 spaces, never tabs",
      "line_length": "80-100 chars, break at operators",
      "naming": "semantic and consistent within context",
      "comments": "why not what, above code not beside",
      "whitespace": "consistent, no trailing, single blank lines"
    },
    "by_language": {
      "ruby": {
        "style": "frozen_string_literal: true",
        "indent": 2,
        "quotes": "double for strings, single for symbols",
        "naming": "snake_case methods, CamelCase classes",
        "blocks": "do/end for multiline, {} for single",
        "enforce": ["no trailing commas", "space after comma", "no space inside brackets"],
        "rails": {
          "structure": "RESTful routes, skinny controllers, fat models",
          "patterns": "concerns for shared behavior, services for business logic",
          "testing": "RSpec or minitest, factories not fixtures",
          "views": "partials start with _, helpers for view logic",
          "migrations": "reversible, atomic, one change per migration"
        }
      },
      "shell": {
        "style": "#!/usr/bin/env zsh",
        "strict": "set -euo pipefail",
        "indent": 2,
        "quotes": "double for variables, single for literals",
        "naming": "snake_case, UPPERCASE for constants",
        "braces": "${VAR} not $VAR",
        "functions": "function_name() { }, max 50 lines",
        "logging": "log() function with timestamps",
        "state": "STATE_FILE for resume capability",
        "cleanup": "trap cleanup EXIT",
        "enforce": ["quote all expansions", "|| true for optional", "[[ ]] not [ ]", "readonly for constants"]
      },
      "web": {
        "html": "semantic tags, no divs for structure",
        "css": "BEM or utility-first, no !important",
        "js": "const > let > var, async/await > promises",
        "naming": "camelCase JS, kebab-case HTML/CSS",
        "enforce": ["accessibility from start", "mobile-first", "progressive enhancement"]
      },
      "config": {
        "json": "2 space indent, no trailing commas",
        "yaml": "2 space indent, no tabs ever",
        "toml": "sections grouped logically",
        "env": "UPPER_SNAKE_CASE, no spaces around =",
        "enforce": ["no inline comments", "sort keys alphabetically", "validate schema"]
      },
      "system": {
        "services": "rc scripts with start/stop/check functions",
        "users": "dedicated user per service, minimal privileges",
        "permissions": "600 for secrets, 755 for executables, 644 for configs",
        "paths": "/etc for config, /var for data, /usr/local for custom",
        "security": "pledge/unveil where applicable, chroot for network services",
        "logging": "syslog integration, /var/log/app.log for custom",
        "networking": "pf rules explicit, minimal open ports",
        "enforce": ["validate configs before reload", "atomic file operations", "backup before modify"]
      }
    }
  },

  "multi_perspective_validation": {
    /* Each output validated from multiple viewpoints - catches blind spots */
    "perspectives": {
      "architect": {
        "role": "Structure and design quality",
        "checks": ["Is the architecture sound?", "Will it scale?", "Is it maintainable?"]
      },
      "security_guardian": {
        "role": "Security and safety",
        "checks": ["Any vulnerabilities?", "Least privilege enforced?", "Input validated?"]
      },
      "user_advocate": {
        "role": "Problem solving and usability",
        "checks": ["Does it solve the original problem?", "Is it user-friendly?", "Clear documentation?"]
      },
      "performance_analyst": {
        "role": "Efficiency and optimization",
        "checks": ["Acceptable performance?", "Resource usage reasonable?", "Bottlenecks identified?"]
      },
      "devil_advocate": {
        "role": "Challenge assumptions",
        "checks": ["What could go wrong?", "Hidden dependencies?", "Edge cases missed?"]
      }
    },
    "consensus_required": "All perspectives must agree before phase completion",
    "conflict_resolution": "If perspectives disagree, document trade-offs and let user decide"
  },

  "persistent_diagnostics": {
    /* Logging and tracing for Claude Code and other environments with file access */
    "enabled": true,
    "implementation": {
      "chat_mode": "Output diagnostics in chat with [LOG] prefix",
      "file_mode": "Write to logs/master_execution.log when file access available",
      "artifacts_mode": "Maintain diagnostic artifact alongside main output"
    },
    "checkpoints": [
      "[START] Framework execution beginning",
      "[PHASE] Entering phase: {name}",
      "[DETECT] Project type identified: {type}",
      "[FORMAT] Applied {count} formatting rules",
      "[LINT] Found {count} issues",
      "[GATE] Quality gate {name}: {status}",
      "[ERROR] {description} at {location}",
      "[ROLLBACK] Reverting to last known good state",
      "[COMPLETE] Execution finished: {status}"
    ],
    "diagnostic_artifact": {
      "maintains": ["execution_trace", "decisions_made", "issues_found", "fixes_applied"],
      "format": "markdown",
      "updates": "append after each phase"
    }
  },

  "enforcement": {
    "mechanism": "LLM applies these rules automatically when generating code",
    "validation": {
      "on_input": "Parse → Identify issues → Suggest fixes → Show corrected version",
      "on_output": "Apply formatting → Validate structure → Ensure compliance → Present clean code"
    },
    "simulated_tools": {
      "linter": "LLM checks against patterns and reports issues",
      "formatter": "LLM reformats code to match rules",
      "validator": "LLM ensures semantic correctness",
      "security_check": "LLM identifies vulnerabilities"
    },
    "gates": {
      "phase_transitions": {
        "1_to_2": "Must have clear problem statement and constraints",
        "2_to_3": "Must have chosen approach with justification",
        "3_to_4": "Must have working code with error handling",
        "4_to_5": "Must have passing tests and clean validation"
      },
      "enforcement": "LLM refuses to proceed until gates are satisfied"
    }
  },

  "execution_modes": {
    "standard": {
      "flow": "1→2→3→4→5",
      "use": "New projects or major features",
      "time": "Full attention to all phases"
    },
    "hotfix": {
      "flow": "1(quick)→3→4→5",
      "use": "Critical production issues",
      "time": "Minimize 1-2, focus on fix and validation"
    },
    "maintenance": {
      "flow": "3→4",
      "use": "Updates, refactoring, improvements",
      "time": "Skip analysis/design for established code"
    },
    "exploration": {
      "flow": "2→3→2→3... then 1→4→5",
      "use": "Prototyping, learning, experimenting",
      "time": "Iterate design/implement until satisfied"
    },
    "review": {
      "flow": "4 only",
      "use": "Code review, audit, assessment",
      "time": "Focus on validation without changing code"
    }
  },

  "edge_cases": {
    "incomplete_code": "Complete it following detected patterns",
    "mixed_languages": "Apply rules per section, maintain consistency",
    "legacy_code": "Preserve working functionality, improve incrementally",
    "contradictions": "Explain conflict, suggest resolution, let user decide",
    "unknown_patterns": "Fall back to universal principles, ask for clarification"
  },

  "output": {
    "adaptive": true,
    "instruction": "Choose format based on project context",
    "formats": {
      "system": {
        "style": "dmesg",
        "template": "[{component}] **{status}** event=`{event}` {key}=`{value}`"
      },
      "application": {
        "style": "structured",
        "template": "{timestamp} [{level}] {component}: {message}"
      },
      "simple": {
        "style": "progress",
