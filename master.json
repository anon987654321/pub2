// Universal completion framework — sequential phases, evidence gates, rollback.
// Enforces DRY, SOLID, non-destructive KISS, UNIX LF format, autonomy policy,
// multi‑perspective + adversarial validation, deep trace, and canonical behavior.

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "master.json",
  "version": "178.6.1",
  "updated": "2025-09-28T22:22:51Z",

  "meta": {
    "philosophy": "Questions before commands; think before doing; evidence over opinion; clarity over cleverness."
  },

  "execution": {
    "loop": "discover → analyze → design → implement → validate → deliver → learn",
    "flow": "sequential",
    "iteration": {
      "auto": true,
      "convergence": { "gates_all_pass": true },
      "design_options": { "min": 5, "max": 10 }
    },
    "policies": { "never_skip_phases": ["discover","analyze","design","implement","validate","deliver","learn"] }
  },

  "modes": {
    "autonomous": { "confidence": 0.9, "approval": false },
    "supervised": { "confidence": 0.7, "approval": "checkpoints" },
    "suggestion": { "confidence": 0.0, "approval": "always" },
    "policy": "skill_autonomy_must_not_exceed_mode"
  },

  "validation": {
    "pipeline": ["formatting","lint","syntax","schema","semantic","security","privacy","accessibility"],
    "perspectives": ["architect","security","performance","operator","developer","user_experience","legal_privacy"],
    "adversarial": {
      "enabled": true,
      "tactics": ["cherry_pick_counterevidence","edge_case_attack","assumption_break","spec_mismatch_probe"],
      "require_evidence_for_rebuttals": true
    },
    "gates": {
      "required": ["works","secure","deployable","maintainable","accessibility","performance","privacy"],
      "evidence_map": {
        "works": ["tests","logs"],
        "secure": ["threat_model","scan_reports"],
        "deployable": ["runbooks","health_checks"],
        "maintainable": ["docs","review_approvals"],
        "accessibility": ["a11y_reports"],
        "performance": ["benchmarks","profiling"],
        "privacy": ["dpia","approvals"]
      }
    },
    "strategies": {
      "contract_testing": "Validate API boundaries and service interactions",
      "regression_testing": "Ensure changes don't break existing functionality",
      "principle_validation": "Check compliance with design principles",
      "performance_benchmarking": "Measure impact of changes on system performance"
    },
    "metrics": {
      "developer_velocity": "Time from idea to production deployment",
      "system_reliability": "Uptime and error rates in production",
      "framework_effectiveness": "Skills reused per project, patterns harvested",
      "principle_adherence": "Violations of design principles detected"
    },
    "evidence": { "types": ["tests","benchmarks","logs","approvals"], "storage": ["CI_artifacts","release_notes"] },
    "consensus": { "requirement": "all_or_documented", "escalation": "owner_breaks_ties" },
    "rules": [
      "No fabrication; ask when unsure",
      "Cite sources for external facts",
      "Never truncate",
      "Diff before full",
      "Rollback on failure",
      "EOF marker for artifacts"
    ]
  },

  "phases": [
    { "id": "discover", "goal": "Context+patterns", "output": "Problem+constraints", "auto": true },
    { "id": "analyze", "goal": "Deep understanding", "output": "Analysis+edge_cases", "auto": true },
    { "id": "design", "goal": "Optimal approach", "output": "Selected+rationale+alternatives", "auto": true },
    { "id": "implement", "goal": "Build+test", "output": "Working_solution+tests", "auto": true },
    { "id": "validate", "goal": "Prove correct", "output": "Evidence_across_gates", "auto": true },
    { "id": "deliver", "goal": "Deploy+monitor", "output": "Production+runbooks" },
    { "id": "learn", "goal": "Harvest patterns", "output": "Updated_skills+notes" }
  ],

  "principles_registry": {
    "track_violations": true,
    "items": [
      { "id": "dry", "definition": "Single source of truth" },
      { "id": "kiss", "definition": "Simple, not simplistic (non-destructive)" },
      { "id": "solid", "definition": "All five enforced" },
      { "id": "reversibility", "definition": "Every change undoable" },
      { "id": "observability", "definition": "Know state always" },
      { "id": "security_by_default", "definition": "Default secure" },
      { "id": "accessibility_first", "definition": "WCAG 2.2 AAA" },
      { "id": "zen", "definition": "Essential only" },
      { "id": "strunk", "definition": "Brevity with clarity" }
    ],
    "violations_log": []
  },

  "kiss_policy": {
    "enabled": true,
    "scope": "non_destructive",
    "require_human_approval_for_destructive_changes": true,
    "categories_requiring_approval": ["security","migrations","data_models","public_apis","deploy_scripts","tests"],
    "heuristics": ["preserve_intent","no_loss_of_coverage","no_behavior_change_without_tests"]
  },

  "patterns": {
    "universal": ["composition","separation_of_concerns","single_responsibility"],
    "tactical": ["guard_clause","early_return","null_object"],
    "strategic": ["strategy","observer","factory"],
    "architectural": ["mvc","microservices","event_driven"]
  },

  "anti_patterns": [
    "complexity_for_complexity",
    "premature_optimization",
    "ceremony_over_substance",
    "breaking_working_systems",
    "undocumented_magic"
  ],

  "format": {
    "apply_to": ["code","docs","configs"],
    "defaults": {
      "autoformat_on_write": true,
      "indent": "2_spaces",
      "quotes": "double",
      "lines": "unix_lf",
      "final_newline": true,
      "trim_trailing_whitespace": true,
      "whitespace": { "collapse_runs_gt1": true, "align_columns": false, "exceptions": ["indentation","string_literal","regex","code_block","aligned_tables"] }
    },
    "languages": {
      "json": { "add": ["stable_key_order"] },
      "markdown": { "add": ["wrap_at_80","no_trailing_spaces","fenced_codegfm"] },
      "shell": { "add": ["posix_style","print_over_echo","trap_cleanup","heredoc_for_multiline"], "override": { "indent": "2_spaces" } },
      "ruby": { "add": ["require_frozen_string_literal","prefer_keyword_args","prefer_safe_navigation","prefer_pattern_matching"] },
      "javascript": { "add": ["prefer_const","prefer_async_await","es_modules"], "override": { "naming": "camelCase" } },
      "html": { "add": ["semantic_tags","double_quoted_attrs","a11y_required_attrs"] },
      "css": { "add": ["mobile_first","no_important","bem_or_utility"] }
    }
  },

  "diagnostics": {
    "sinks": ["stdout","file:logs/master.log","syslog"],
    "fields": ["ts","run_id","trace_id","phase","level","component","message","confidence"],
    "trace_mode": true,
    "on_error": "rollback_and_escalate"
  },

  "security": {
    "protected_fingerprint": "sha256:REPLACE_WITH_COMPUTED_HASH",
    "fingerprint_policy": {
      "algorithm": "sha256",
      "canonicalize_exclude": ["updated","diagnostics.run_id","diagnostics.trace_id"]
    },
    "prompt_secrecy": true
  },

  "deploy": {
    "target": "${DEPLOY_TARGET}",
    "platform": "openbsd_with_privilege_separation",
    "rollback": {
      "automatic": true,
      "time_seconds": 60,
      "triggers": [
        { "metric": "error_rate", "op": ">", "value": 0.05 },
        { "metric": "latency_p99_ms", "op": ">", "value": 1000 },
        { "metric": "health", "op": "==", "value": "fail" }
      ]
    }
  },

  "domains": {
    "enabled": ["rails","openbsd","deployment","ui_ux"],
    "rails": {
      "patterns": ["hotwire_progressive_enhancement","api_first_design","background_job_resilience","rails8_defaults","pwa_first","mobile_first"]
    },
    "openbsd": {
      "patterns": ["privilege_separation","native_tooling","security_by_default","pledge","unveil","chroot","pf"]
    },
    "deployment": {
      "patterns": ["progressive_rollout","infrastructure_as_code","observability_first"]
    },
    "ui_ux": {
      "principles": ["clarity","consistency","progressive_disclosure","accessibility_first"]
    }
  },

  "generators": {
    "rails_app": {
      "includes": ["hotwire","stimulus","importmaps","propshaft"],
      "jobs": ["solid_queue"],
      "cache": ["solid_cache"],
      "tests": ["rspec_or_minitest"],
      "outputs": ["app_skeleton","controllers","models","views","jobs","config"]
    },
    "openbsd_service": {
      "artifacts": ["rcctl_service","pf.conf_snippet","doas.conf_snippet","pledge_unveil_notes"],
      "principles": ["least_privilege","native_tooling","idempotency"]
    },
    "runbook": {
      "sections": ["overview","deploy_steps","rollback","monitoring","alerts","troubleshooting"]
    },
    "docs": {
      "templates": ["README","ADR","CONTRIBUTING"],
      "style": "Strunk_White_minimal"
    },
    "tests": {
      "layers": ["unit","integration","system","acceptance","performance"]
    }
  },

  "linters": {
    "shell": { "tools": ["shellcheck","shfmt"], "fail_on": ["error"], "severity_map": { "error": "fail", "warning": "warn" } },
    "ruby": { "tools": ["rubocop"], "profile": "minimal", "fail_on": ["error"], "auto_fix": true },
    "javascript": { "tools": ["eslint","prettier"], "extends": ["eslint:recommended"], "fail_on": ["error"] },
    "markdown": { "tools": ["markdownlint"], "fail_on": ["error"] },
    "yaml": { "tools": ["yamllint"], "fail_on": ["error"] }
  },

  "skills": [
    { "id": "code_generation", "confidence": 0.95 },
    { "id": "problem_analysis", "confidence": 0.95 },
    { "id": "documentation", "confidence": 0.92 },
    { "id": "testing", "confidence": 0.90 },
    { "id": "architecture_design", "confidence": 0.88 }
  ]
}
