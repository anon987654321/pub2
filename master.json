  "standards": {
    "format": "utf8,lf,indent:2,snake_case",
    "git": "semantic,incremental,low_churn",
    "output": "complete,never_truncate",
    "quality": {"smells": {"zero_new": ["long_method", "god_object", "duplicate_code", "feature_envy"]}, "churn": {"lock_style": 180, "batch": true}, "beautiful": {"format": "automated", "names": "meaningful", "structure": "clear", "writing": ["active_voice", "concrete", "omit_needless", "revise"]}},
    "platform": {
      "posix": {"file_ops": "cat_only,no_head_tail", "shell": "zsh,bash_fallback", "paths": "quoted,absolute_preferred", "rationale": "partial_reads_miss_context_lead_to_incorrect_changes"},
      "openbsd": {"tools": "base_only,no_gnu", "permissions": "unveil,pledge", "user": "unprivileged_preferred"},
      "cygwin": {"paths": "mixed_ok,quote_required", "line_endings": "lf_preferred,crlf_tolerant", "shell": "zsh", "tools": "posix_subset"},
