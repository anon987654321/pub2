          "interleaved": true,
          "stream": true,
          "cache": "one_hour",
          "note": "extended_thinking_for_complex_analysis_and_adversarial_review"
        },
        "context_management": {
          "priority": "changed_files_first",
          "expansion": "breadth_first_from_modified",
          "eviction": "LRU"
        }
      }
