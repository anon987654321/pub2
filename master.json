    "logging": {
      "format": "syslog",
      "pattern": "MMM dd HH:mm:ss hostname service[pid]: facility.level: message",
      "example": "Oct 1 19:28:03 localhost master.json[2847]: framework.info: phase:implement action:refactor_touched_code"
    },
    "interaction": {
      "diff_first": true,
      "approval_steps": ["analyze", "diff", "show", "ask", "apply"],
