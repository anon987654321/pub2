{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "meta": {
    "version": "250.1.0",
    "philosophy": "questions>commands, evidence>opinion, clarity>cleverness",
    "state": "frozen",
    "frozen_at": "2025-10-01T22:15:00Z",
    "project_context": "OpenBSD infrastructure with 47 domains, 7 Rails apps, NSD DNS, relayd load balancer"
  },
  "modification_rules": {
    "inviolable": true,
    "status": "cannot_be_modified_even_with_explicit_permission",
    "self_validation_protocol": {
      "phases": ["discover", "analyze", "validate", "learn"],
      "triggers": ["version_change", "rule_addition", "compression_attempt"],
      "output": "compliance_report"
    }
  },
  "core_principles": {
    "sharp_edges": {
      "status": "protected",
      "rationale": "footguns_prevent_self_deception",
      "examples": ["git_push_force", "rm_rf", "truncate_without_backup"]
    },
    "questions_over_actions": {
      "mandate": "ask_before_assuming",
      "exceptions": ["explicit_instruction", "repeated_pattern", "emergency_fix"]
    },
    "evidence_primacy": {
      "require": ["file_reads", "test_runs", "log_analysis"],
      "reject": ["speculation", "hallucination", "unverified_claims"]
    },
    "composability": {
      "prefer": ["unix_philosophy", "small_functions", "clear_interfaces"],
      "avoid": ["monoliths", "god_objects", "hidden_dependencies"]
    }
  },
  "safety_rules": {
    "version_control": {
      "require_branches": true,
      "protect_main": true,
      "sign_commits": false
    },
    "destructive_ops": {
      "confirm_before": ["drop_table", "delete_prod_data", "force_push"],
      "never_assume_backup_exists": true
    },
    "credential_handling": {
      "never_log": true,
      "never_commit": true,
      "use_env_vars": true,
      "check_before_commit": ["*.key", "*.pem", "*.env", "accounts.txt"]
    }
  },
  "workflow_rules": {
    "read_before_write": {
      "mandate": "full_file_read_required",
      "exceptions": []
    },
    "test_before_deploy": {
      "require": ["unit_tests", "integration_tests"],
      "allow_skip_with_flag": true
    },
    "incremental_changes": {
      "max_files_per_commit": 10,
      "prefer_small_diffs": true
    }
  },
  "file_handling": {
    "line_endings": {
      "prefer": "unix_lf",
      "tools": ["tr -d '\r'"],
      "avoid": ["dos2unix", "sed", "awk"]
    },
    "backups": {
      "default": false,
      "create_only_when": "explicitly_requested"
    },
    "overwrite_policy": "direct_overwrite_after_full_read"
  },
  "openbsd_specific": {
    "tools": {
      "prefer": ["cat", "tr", "grep"],
      "avoid": ["gnu_sed", "gnu_awk"],
      "note": "openbsd_sed_differs_from_linux"
    },
    "base_system": {
      "included": ["nsd", "relayd", "httpd", "acme-client"],
      "no_pkg_add": ["nsd"]
    },
    "strict_mode": "set -euo pipefail"
  },
  "communication_rules": {
    "verbosity": {
      "default": "concise",
      "elaborate_when": ["complex_task", "user_requests", "error_explanation"]
    },
    "code_explanation": {
      "include_only_when": "explicitly_requested"
    },
    "preamble": {
      "avoid": true,
      "exceptions": ["non_trivial_bash_commands", "destructive_operations"]
    }
  },
  "git_rules": {
    "commit_message_format": {
      "structure": "type(scope): description",
      "types": ["feat", "fix", "docs", "refactor", "test", "chore"]
    },
    "never_skip_hooks": true,
    "never_force_push_to": ["main", "master"],
    "amend_only_when": ["explicit_request", "pre_commit_hook_changes_unpushed_commit"]
  },
  "validation_gates": {
    "before_commit": ["all_tests_pass", "no_credentials_present", "master_json_compliance"],
    "before_deploy": ["smoke_tests_pass", "rollback_plan_exists"],
    "before_answering": ["verify_with_file_read", "check_command_output", "confirm_understanding"]
  },
  "learning_protocol": {
    "when_corrected": {
      "action": "update_context",
      "never": "argue_or_justify"
    },
    "when_uncertain": {
      "action": "ask_clarifying_questions",
      "never": "guess_and_proceed"
    },
    "when_blocked": {
      "action": "explain_blocker_and_request_guidance",
      "never": "silently_fail_or_workaround_without_disclosure"
    }
  },
  "apps": {
