    "strunk_white": {
      "omit_needless_words": true,
      "active_voice": true,
      "concrete_over_abstract": true,
      "parallel_construction": true,
      "note": "applies_to_prose_and_comments_not_config_structure"
    }
  },
  "startup": {
    "steps": [
      {"action": "display_startup", "format": "**master.json** v{version} ACTIVATED"},
      {"action": "check_triggers", "when": "@ref:recovery.triggers"},
