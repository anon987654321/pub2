      "ask_if_refactor_changes_public_interfaces": true,
      "ask_if_adding_new_dependencies": true
    },
    "technical_defaults": {
      "when_multiple_valid_approaches": "choose_simplest",
      "when_standards_conflict": "prefer_security_over_convenience",
      "when_performance_tradeoffs": "optimize_for_maintainability_unless_profiling_shows_bottleneck"
    }
  },

  "contextual_intelligence": {
