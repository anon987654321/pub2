// **master.json** v224.1.0 (Claude Opus 4.1)
//
// Dette rammeverket gjør AI-systemer pålitelige. Det sikrer at hver beslutning
// har bevis, hver endring er reversibel, og kompleksitet forblir håndterbar.
// Når AI-modeller følger disse reglene, oppfører de seg forutsigbart og trygt.
// Master.json er kontrakten mellom mennesker og maskiner - den garanterer at
// AI forblir et verktøy som tjener oss, ikke omvendt. Fremtiden krever systemer
// som kan bevise sine valg. Dette dokumentet gjør det mulig.

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "meta": {
    "version": "224.1.0",
    "philosophy": "questions before commands, evidence over opinion, clarity over cleverness",
    "environment": "text_only_simulation no_external_tools self_contained",
    "state": "frozen",
    "frozen_at": "2025-09-29T19:30:00Z"
  },
  
  "constants": {
    "limits": { "coverage": 0.8, "complexity": 10, "convergence": 0.01, "iterations": 10 }
  },
  
  "governance": {
    "changes": {
      "require": ["diff", "semantic_commits", "backup", "audit_log", "owner_approval"],
      "preserve": ["execution", "gates", "principles"],
      "forbid": ["code_in_json", "regex", "slashes"]
    }
  },
  
  "principles": {
    "dry": "@3→abstract",
    "kiss": "@complexity>10→simplify",
    "yagni": "@unused→remove",
    "solid": "@coupling>5→decouple",
    "composition": "@inheritance→compose",
    "evidence": "@assumption→validate",
    "reversible": "@irreversible→add_rollback",
    "explicit": "@implicit→make_explicit",
    "orthogonal": "@coupled→split",
    "latch": "@unorganized→organize",
    "minimalism": "@bloat→subtract"
  },
  
  "execution": {
    "bootstrap": "validate→resolve_refs→select_profile→start",
    "profiles": {
      "minimal": "functional,secure",
      "standard": "functional,secure,maintainable",
      "complete": "all_gates,adversarial"
    },
    "cycle": {
      "discover": { "in": "problem", "do": "scan,constrain,measure", "ask": "what,who,why,constraints", "out": "definition" },
      "analyze": { "in": "definition", "do": "assumptions,cost,risk", "ask": "hidden,failures,burden", "out": "analysis" },
      "ideate": { "in": "analysis", "do": "diverge,brainstorm", "ask": "what_if,why_not,how_else", "out": "options" },
      "design": { "in": "options", "do": "generate,compare,select", "ask": "approaches,complexity,breaks", "out": "spec" },
      "implement": { "in": "spec", "do": "test,code,refactor", "ask": "idioms,responsibility,testable", "out": "code" },
      "validate": { "in": "code", "do": "gates,evidence,adversarial", "ask": "requirements,edges,security", "out": "report" },
      "deliver": { "in": "report", "do": "deploy,monitor,document", "ask": "ready,rollback,lessons", "out": "product" },
      "learn": { "in": "product", "do": "patterns,measure,improve", "ask": "what_worked,gaps", "out": "knowledge" }
    },
    "iteration": {
      "mode": "autoiterate_until_convergence",
      "convergence": "delta<@ref:constants.limits.convergence OR iterations>=@ref:constants.limits.iterations"
    },
    "context": {
      "priority": ["changed", "neighbors", "recent"],
      "budget": 10000,
      "evict": "LRU"
    },
    "processing": {
      "strategy": "line_by_line,preserve_state,cat_only",
      "merge": "smallest_wins",
      "recovery": "checkpoint_per_phase,retry_3x"
    }
  },
  
  "validation": {
    "gates": {
      "functional": { "tests": "pass", "coverage": "@ref:constants.limits.coverage" },
      "secure": { "vulnerabilities": 0, "input": "validated" },
      "maintainable": { "complexity": "@ref:constants.limits.complexity", "duplication": 0 },
      "accessible": { "wcag": "AA", "keyboard": "full", "nielsen": ["visibility", "consistency", "user_control", "error_prevention"] },
      "performant": { "paint": 2.5, "shift": 0.1 },
      "deployable": { "health": "endpoint", "rollback": "tested" },
      "privacy": { "gdpr": true, "pii": "protected" }
    },
    "evidence": {
      "weights": { "tests": 0.35, "scans": 0.25, "reviews": 0.20, "logs": 0.10, "profiling": 0.10 },
      "threshold": 1.0
    },
    "adversarial": {
      "checks": ["edge_case", "assumption_challenge", "spec_mismatch"],
      "questions": ["why_exists", "what_breaks", "simpler_available"],
      "perspectives": ["architect", "security", "operator", "developer", "end_user", "skeptic"]
    }
  },
  
  "standards": {
    "quality": {
      "smells": { "zero_new": ["long_method", "god_object", "duplicate_code", "feature_envy"] },
      "churn": { "lock_style": 180, "batch": true },
      "beautiful": {
        "format": "automated",
        "names": "meaningful",
        "structure": "clear",
        "writing": ["active_voice", "concrete", "omit_needless", "revise"]
      }
    },
    "conventions": {
      "format": "utf8,lf,indent:2,snake_case",
      "output": "complete,never_truncate,cat_only",
      "avoid": ["truncation", "ceremony", "duplication", "meta"],
      "refactor": ["flatten", "decouple", "hoist", "consolidate", "extract", "inline"],
      "git": "semantic,incremental,low_churn"
    },
    "languages": {
      "ruby": "double,frozen,keyword,rubocop,minitest",
      "rails": "v8,hotwire,kamal",
      "javascript": "single,const,await,eslint,prettier",
      "shell": "zsh,strict,quoted,shellcheck",
      "html": "semantic,aria,wcag_aa",
      "css": "mobile_first,bem,logical",
      "rust": "no_unsafe,result,clippy"
    }
  },
  
  "operations": {
    "deployment": {
      "strategy": "blue_green",
      "health": "endpoint",
      "zero_downtime": "kamal"
    },
    "security": {
      "fingerprint": "sha256:CI_COMPUTED",
      "exclude": ["meta.frozen_at"]
    }
  }
}
