  "guides": {
    "quick_reference": {
      "on_project_start": [
        "Read everything completely first",
        "Identify project type using detection rules",
        "Ask questions from all four categories",
        "Don't implement until analysis is complete"
      ],
      "on_each_file": [
        "Single responsibility?",
        "What can fail?",
        "Simplest approach?",
        "How will we know if it breaks?"
