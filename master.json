      "principles": {
        // Expanded principles with definition, why, how, pitfalls, and examples to guide LLMs and humans.
        "dry": {
          "definition": "Don't repeat yourself beyond the rule of three; achieve a single source of truth.",
          "why": "Duplication breeds inconsistency and defects.",
          "how_to_apply": [
            "Abstract only after the third duplication",
            "Prefer composition over inheritance",
            "Centralize configuration and constants"
          ],
          "pitfalls": [
            "Over-abstracting too early",
            "Coupling unrelated concerns"
          ],
          "examples": ["Extract shared query builders", "Shared validators"],
          "anti_examples": ["Abstracting on first sight", "Monolithic utility classes"]
        },
        "kiss": {
          "definition": "Keep it simple and small while preserving intent; remove accidental complexity only.",
          "why": "Simplicity reduces defects and accelerates change.",
          "how_to_apply": [
            "Prefer straightforward data flows",
            "Choose the simplest structure that meets requirements",
            "Avoid magic and hidden coupling"
          ],
          "pitfalls": [
            "Destructive simplification that removes essential safeguards",
            "Reinventing standard features"
          ],
          "examples": ["Early return guards", "Flat data structures"],
          "anti_examples": ["Clever metaprogramming for trivial tasks"]
        },
        "solid": {
          "definition": "Apply SOLID in OOP contexts where it improves clarity and testability.",
          "why": "Improves modularity and change resilience.",
          "how_to_apply": [
            "Single Responsibility per class/module",
            "Interfaces small and specific",
            "Depend on abstractions not concretions"
          ],
          "pitfalls": ["Over-engineering with excessive indirection"]
        },
        "yagni": {
          "definition": "Build only what is needed now; avoid speculative features.",
          "why": "Reduces scope, churn, and maintenance burden.",
          "how_to_apply": ["Cut features without current users", "Defer hooks until justified"]
        },
        "composition": {
          "definition": "Prefer composition and small units over inheritance hierarchies.",
          "why": "Lowers coupling and increases reuse.",
          "how_to_apply": ["Compose behaviors via modules/functions", "Use delegation patterns"]
        },
        "evidence": {
          "definition": "Decisions require verifiable evidence or references.",
          "how_to_apply": ["Link benchmarks, tests, and scans", "Document trade-off tables"]
        },
        "reversible": {
          "definition": "Every change must be easy to undo with minimal data loss.",
          "how_to_apply": ["Write migrations with down paths", "Keep feature flags", "Isolate risky changes"]
        },
        "explicit": {
          "definition": "Prefer explicit configuration and flows over implicit magic.",
          "how_to_apply": ["Name things concretely", "Avoid hidden global state"]
        },
        "orthogonal": {
          "definition": "Keep concerns independent, minimize cross-effects.",
          "how_to_apply": ["Split modules by concern", "Define clean interfaces"]
        },
        "no_false_tradeoffs": {
          "definition": "Seek both-and solutions; avoid framing compromises where none are needed.",
          "how_to_apply": ["Prototype alternatives", "Validate with data"]
        }
      },
      "kiss_protection": {
