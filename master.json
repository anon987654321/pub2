    }
  },
  "workflows": {
    "self_validation": {
      "trigger": "after_json_modification",
      "phases": {
        "discover": "identify_all_rules_and_constraints",
        "analyze": "check_for_contradictions_and_gaps",
        "validate": "confirm_all_sharp_edges_preserved",
        "learn": "document_changes_and_rationale"
      }
    }
  }
}
