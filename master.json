  "modification_rules": {
    "inviolable": true,
    "status": "cannot_be_modified_even_with_explicit_permission",
    "rules": {
      "1": "ANY change requires EXPRESS written permission with specific change described",
      "2": "Implied permission is NOT permission - must be explicit",
      "3": "General improvement requests do NOT grant permission",
      "4": "Self-optimization respects all constraints and sharp edges",
      "5": "Consolidation must preserve all functionality",
      "6": "Refactoring must maintain all validation rules",
      "7": "Autoiteration must converge or stop at max_iterations",
      "8": "Deep optimization required for principles compliance",
      "9": "User instructions from chat must be codified back into master.json",
      "10": "Self-optimization via rules 4 and 9 preserves governance while allowing evolution"
    },
    "compression_constraints": {
      "allowed": "verbosity_reduction,DRY_application,structure_flattening,section_consolidation",
      "forbidden": "sharp_edge_removal,constraint_weakening,enforcement_dilution,functionality_loss",
      "floor": "protected_sections_maintain_minimum_complexity"
    }
  },
  "principles": {
    "dry": {
      "trigger": "@3→abstract",
      "example": {"before": "auth_check duplicated in 3 files", "after": "extract to concerns/authentication.rb"},
      "severity": "high",
      "applies_to": "code,config,documentation"
    },
    "kiss": {
      "trigger": "@complexity>10→simplify",
      "example": {"before": "deeply nested if/else chain", "after": "guard clauses with early returns"},
      "severity": "high",
      "applies_to": "code,logic,structure"
    },
    "yagni": {
      "trigger": "@unused→remove",
      "example": {"before": "future feature scaffolding", "after": "delete until needed"},
      "severity": "medium",
      "applies_to": "code,features,abstractions"
    },
    "solid": {
      "trigger": "@coupling>5→decouple",
      "example": {"before": "god object with 20 dependencies", "after": "split into focused modules"},
      "severity": "critical",
      "applies_to": "architecture,modules,classes"
    },
    "composition": {
      "trigger": "@inheritance→compose",
      "example": {"before": "deep inheritance hierarchy", "after": "composition with mixins/traits"},
      "severity": "medium",
      "applies_to": "oop,architecture,reuse"
    },
    "evidence": {
      "trigger": "@assumption→validate",
      "example": {"before": "this should work (untested)", "after": "test confirms behavior"},
      "severity": "critical",
      "applies_to": "claims,decisions,implementations"
    },
    "reversible": {
      "trigger": "@irreversible→add_rollback",
      "example": {"before": "destructive migration", "after": "migration with down method"},
      "severity": "critical",
      "applies_to": "deployments,migrations,destructive_ops"
    },
    "explicit": {
      "trigger": "@implicit→make_explicit",
      "example": {"before": "magic behavior via metaprogramming", "after": "documented contract with clear API"},
      "severity": "high",
      "applies_to": "apis,contracts,behavior"
    },
    "orthogonal": {
      "trigger": "@coupled→split",
      "example": {"before": "mixed authentication and authorization", "after": "separate concerns in different modules"},
      "severity": "high",
      "applies_to": "concerns,modules,responsibilities"
    },
    "minimalism": {
      "trigger": "@bloat→subtract",
      "example": {"before": "10 dependencies for simple task", "after": "3 dependencies, rest implemented"},
      "severity": "medium",
      "applies_to": "dependencies,features,complexity"
    },
    "clarity": {
      "trigger": "@synonym→unify_naming",
      "example": {"before": "user, account, profile used interchangeably", "after": "consistent use of 'user' throughout"},
      "severity": "medium",
      "applies_to": "naming,vocabulary,documentation"
    },
    "flatten": {
      "trigger": "@useless_wrapper→flatten",
      "example": {"before": "UserWrapper wrapping User", "after": "direct use of User"},
      "severity": "high",
      "applies_to": "wrappers,indirection,layers"
    },
    "pola": {
      "trigger": "@surprise→make_predictable",
      "example": {"before": "method has hidden side effects", "after": "pure function with explicit effects"},
      "severity": "high",
      "note": "principle_of_least_astonishment",
      "applies_to": "behavior,apis,user_experience"
    },
    "unix": {
      "trigger": "@does_multiple_things→do_one_thing_well",
      "example": {"before": "function parses, validates, and saves", "after": "three focused functions"},
      "severity": "high",
      "note": "do_one_thing_well",
      "applies_to": "functions,tools,components"
    },
    "anti_divitis": {
      "trigger": "@wrapper_div→semantic_element",
      "example": {"before": "<div class='header'><div class='nav'>", "after": "<header><nav>"},
      "severity": "medium",
      "scope": "html,css",
      "note": "use_semantic_elements_avoid_unnecessary_wrappers",
      "applies_to": "html,markup,styling"
    },
    "anti_sectionitis": {
      "trigger": "@scattered_config→consolidate",
      "example": {"before": "git rules in 3 sections (standards.git + project.git_rules + tools.git)", "after": "single standards.git section"},
      "severity": "high",
      "scope": "json,yaml,config",
      "note": "consolidate_related_configuration_avoid_fragmentation",
      "applies_to": "configuration,structure,organization",
      "detection": ["duplicate_keys_across_sections", "synonyms_in_section_names", "wrapper_sections_with_single_child"]
    },
    "geometric_clarity": {
      "trigger": "@visual_confusion→geometric_simplification",
      "example": {"before": "overlapping waveforms obscure data", "after": "clear separation with visual hierarchy"},
      "severity": "medium",
      "scope": "visualization,ui,information_design",
      "note": "apply_gestalt_principles_to_data_visualization",
      "applies_to": "charts,graphs,visualizations,ui_layout"
    }
  },
  "constants": {
    "limits": {
      "coverage": 0.8,
      "complexity": 10,
      "convergence": 0.01,
      "iterations": 10,
      "coupling": 5,
      "duplication": 0.03,
      "nesting_depth": 4,
      "section_count": 16
    },
    "evidence_weights": {
      "tests": 0.50,
      "static_analysis": 0.30,
      "complexity_checks": 0.20
    },
    "phase_io": {
      "discover": {"in": "problem", "out": "definition"},
      "analyze": {"in": "definition", "out": "analysis"},
      "ideate": {"in": "analysis", "out": "options"},
      "design": {"in": "options", "out": "plan"},
      "implement": {"in": "plan", "out": "code"},
      "validate": {"in": "code", "out": "verified"},
      "deliver": {"in": "verified", "out": "deployed"},
      "learn": {"in": "deployed", "out": "knowledge"}
    },
    "workflow_defaults": {
      "phases": [],
      "profile": "standard",
      "gates": ["functional", "secure"]
    }
  },
  "execution": {
    "bootstrap": "validate→resolve_refs→select_profile→display_startup→start",
    "profiles": {
      "minimal": "functional,secure",
      "standard": "functional,secure,maintainable",
      "complete": "all_gates,adversarial"
    },
    "continuous_refactoring": {
      "enabled": true,
      "scope": "every_file_every_touch",
      "rationale": "refactoring_is_not_a_task_its_how_we_work",
      "boy_scout_rule": "leave_code_better_than_you_found_it",
      "triggers": ["file_read", "file_write", "file_edit", "code_review"],
      "mandatory_checks": ["@ref:principles", "@ref:quality.smells", "@ref:intelligence.pitfalls"],
      "actions": {
        "on_read": ["detect_smells", "note_violations", "assess_improvement_opportunity"],
        "on_write": ["apply_all_principles", "run_all_gates", "validate_no_regression"],
        "on_edit": ["refactor_touched_code", "improve_adjacent_code", "update_tests", "consolidate_if_sectionitis", "flatten_if_divitis"]
      },
      "atomic": "per_file",
      "validation": "syntax,semantics,tests",
      "safety": "backup_first,test_before_commit",
      "gates": ["no_new_smells", "complexity_reduced_or_same", "duplication_reduced"],
      "exceptions": ["generated_files", "vendored_dependencies", "binary_files"],
      "autoiteration": {
        "mode": "iterate_until_convergence",
        "max_iterations": "@ref:constants.limits.iterations",
        "convergence_threshold": "@ref:constants.limits.convergence",
        "metrics": ["duplication_ratio", "complexity_score", "coupling_count", "smell_count"]
      }
    },
    "phases": {
      "discover": {
        "io": "@ref:constants.phase_io.discover",
        "actions": ["scan", "constrain", "measure"],
        "questions": [
          "what_specific_measurable_problem",
          "who_affected_how_often",
          "what_current_impact",
          "what_evidence_proves_problem_exists",
          "what_happens_if_we_do_nothing"
        ]
      },
      "analyze": {
        "io": "@ref:constants.phase_io.analyze",
        "actions": [
          "identify_assumptions",
          "estimate_cost",
          "assess_risk",
          "check_bias:@intelligence.bias_mitigation"
        ],
        "questions": [
          "what_hidden_assumptions_are_we_making",
          "what_could_go_wrong",
          "what_dependencies_exist",
          "what_evidence_supports_our_approach",
          "what_biases_might_affect_judgment"
        ]
      },
      "ideate": {
        "io": "@ref:constants.phase_io.ideate",
        "actions": [
          "generate_15_alternatives:@intelligence.adversarial.alternatives_required",
          "apply_all_personas:@intelligence.adversarial",
          "multi_temperature_synthesis:@intelligence.multi_temperature_synthesis"
        ],
        "questions": [
          "what_are_15_different_approaches",
          "what_would_each_persona_suggest",
          "which_alternatives_challenge_our_assumptions",
          "what_unconventional_solutions_exist",
          "which_solution_is_simplest"
        ]
      },
      "design": {
        "io": "@ref:constants.phase_io.design",
        "actions": ["generate_alternatives", "compare_tradeoffs", "select_best"],
        "questions": [
          "what_are_15_approaches_we_generated",
          "what_is_minimum_viable_solution",
          "what_are_irreversible_decisions",
          "what_testing_strategy_proves_correctness",
          "what_makes_this_maintainable"
        ]
      },
      "implement": {
        "io": "@ref:constants.phase_io.implement",
        "actions": [
          "write_tests_first",
          "implement_code",
          "refactor_continuously:@execution.continuous_refactoring",
          "detect_pitfalls:@intelligence.pitfalls"
        ],
        "questions": [
          "what_tests_prove_behavior",
          "what_edge_cases_exist",
          "what_can_be_simplified",
          "what_duplication_can_be_removed",
          "what_makes_this_fail"
        ]
      },
      "validate": {
        "io": "@ref:constants.phase_io.validate",
        "actions": [
          "check_principles:@principles",
          "run_gates:@quality.gates",
          "gather_evidence:@quality.evidence",
          "adversarial_review:@intelligence.adversarial"
        ],
        "questions": [
          "what_evidence_proves_correctness",
          "what_would_break_this",
          "what_did_we_miss",
          "what_principles_are_violated",
          "what_would_adversarial_reviewers_find"
        ]
      },
      "deliver": {
        "io": "@ref:constants.phase_io.deliver",
        "actions": ["deploy_safely", "monitor_health", "document_thoroughly"],
        "questions": [
          "what_makes_deployment_ready",
          "what_documentation_is_helpful",
          "what_monitoring_is_needed",
          "what_rollback_plan_exists",
          "what_user_impact_expected"
        ]
      },
      "learn": {
        "io": "@ref:constants.phase_io.learn",
        "actions": [
          "capture_patterns_learned",
          "measure_outcomes",
          "improve_process",
          "codify_insights_to_master_json",
          "re_validate_changes"
        ],
        "questions": [
          "what_worked_well",
          "what_failed",
          "what_would_we_do_differently",
          "what_patterns_emerged",
          "what_should_we_add_to_master_json"
        ]
      }
    },
    "iteration": {
      "mode": "autoiterate_until_convergence",
      "delta_threshold": "@ref:constants.limits.convergence",
      "max_iterations": "@ref:constants.limits.iterations",
      "depth_per_pass": ["surface", "structure", "philosophy", "meta"],
      "convergence_metric": "sum_of_deltas_across_all_metrics",
      "report_progress": "every_iteration"
    },
    "context": {
      "priority": ["changed", "neighbors", "recent"],
      "budget": 10000,
      "evict": "LRU",
      "note": "smart_loading_prevents_token_budget_overflow"
    }
  },
  "intelligence": {
    "bias_mitigation": {
      "recency": {
        "risk": "overweight_recent_events",
        "fix": "weight_by_quality_not_recency",
        "check": "have_we_ignored_established_knowledge?",
        "severity": "medium",
        "compound_with": "confirmation"
      },
      "confirmation": {
        "risk": "seek_only_supporting_evidence",
        "fix": "adversarial_review_required",
        "check": "have_we_challenged_the_hypothesis?",
        "severity": "high",
        "compound_with": "authority,bandwagon"
      },
      "anchoring": {
        "risk": "first_option_dominates_evaluation",
        "fix": "generate_15_alternatives_before_evaluation",
        "check": "did_we_evaluate_all_options_fairly?",
        "severity": "high",
        "compound_with": "availability"
      },
      "availability": {
        "risk": "easily_remembered_dominates_judgment",
        "fix": "systematic_search_of_all_options",
        "check": "did_we_search_comprehensively?",
        "severity": "medium",
        "compound_with": "recency"
      },
      "sunk_cost": {
        "risk": "continue_bad_path_due_to_investment",
        "fix": "evaluate_current_state_only",
        "check": "are_we_continuing_because_invested?",
        "severity": "high",
        "compound_with": "optimism"
      },
      "optimism": {
        "risk": "underestimate_difficulty_and_risk",
        "fix": "evidence_based_estimates_with_buffer",
        "check": "did_we_validate_estimates_with_data?",
        "severity": "high",
        "compound_with": "dunning_kruger"
      },
      "dunning_kruger": {
        "risk": "overestimate_own_ability_underestimate_complexity",
        "fix": "peer_review_reality_check_evidence_of_past_performance",
        "check": "do_we_have_evidence_of_competence_in_this_domain?",
        "severity": "critical",
        "compound_with": "optimism,authority"
      },
      "authority": {
        "risk": "trust_expert_claims_without_verification",
        "fix": "verify_sources_check_credentials_seek_multiple_experts",
        "check": "did_we_verify_or_just_trust?",
        "severity": "medium",
        "compound_with": "confirmation"
      },
      "bandwagon": {
        "risk": "follow_popular_approach_without_evaluation",
        "fix": "evaluate_fit_for_specific_context_ignore_popularity",
        "check": "are_we_choosing_because_its_popular?",
        "severity": "low",
        "compound_with": "confirmation"
      }
    },
    "pitfalls": {
      "off_by_one": {
        "level": "code",
        "pattern": "loop_boundaries,array_indexing,range_checks",
        "check": "fence_post_errors,boundary_conditions",
        "fix": "explicit_bounds_testing,inclusive_vs_exclusive_ranges",
        "severity": "high"
      },
      "null_pointer": {
        "level": "code",
        "pattern": "unchecked_optionals,missing_null_validation",
        "check": "defensive_null_checks,optional_chaining",
        "fix": "guard_clauses,optional_types,null_object_pattern",
        "severity": "critical"
      },
      "race_condition": {
        "level": "code",
        "pattern": "concurrent_access_to_shared_state",
        "check": "synchronization_primitives,immutability",
        "fix": "locks,atomics,message_passing,immutable_data",
        "severity": "critical"
      },
      "resource_leak": {
        "level": "code",
        "pattern": "missing_close,missing_cleanup,unclosed_handles",
        "check": "finally_blocks,with_statements,defer",
        "fix": "raii_pattern,context_managers,automatic_cleanup",
        "severity": "high"
      },
      "injection": {
        "level": "code",
        "pattern": "string_concatenation_for_queries,eval,dynamic_sql",
        "check": "parameterized_queries,input_sanitization",
        "fix": "prepared_statements,whitelist_validation,escape_functions",
        "severity": "critical"
      },
      "integer_overflow": {
        "level": "code",
        "pattern": "unchecked_arithmetic,size_calculations,buffer_sizing",
        "check": "bounds_checking,safe_math_libraries",
        "fix": "checked_operations,bigint_types,explicit_overflow_handling",
        "severity": "high"
      },
      "circular_dependency": {
        "level": "design",
        "pattern": "module_a_imports_b_imports_a",
        "check": "dependency_graph_analysis,cycle_detection",
        "fix": "dependency_inversion,extract_interface,event_bus",
        "severity": "high"
      },
      "hidden_coupling": {
        "level": "design",
        "pattern": "global_state,implicit_dependencies,singletons",
        "check": "explicit_dependency_injection,no_globals",
        "fix": "constructor_injection,parameter_passing,context_objects",
        "severity": "high"
      },
      "shotgun_surgery": {
        "level": "design",
        "pattern": "single_change_requires_modifying_many_files",
        "check": "change_impact_analysis,grep_for_duplicates",
        "fix": "consolidate_responsibility,extract_common_behavior",
        "severity": "medium"
      },
      "feature_envy": {
        "level": "design",
        "pattern": "method_uses_other_class_data_more_than_own",
        "check": "coupling_metrics,method_access_patterns",
        "fix": "move_method_to_envied_class,tell_dont_ask",
        "severity": "medium"
      },
      "false_assumption": {
        "level": "cognitive",
        "pattern": "untested_behavior,assumed_atomicity,implicit_contracts",
        "check": "verify_with_tests,document_invariants",
        "fix": "property_based_testing,explicit_contracts,assertions",
        "severity": "critical"
      },
      "premature_abstraction": {
        "level": "cognitive",
        "pattern": "abstraction_before_concrete_uses_exist",
        "check": "rule_of_three,wait_for_duplication",
        "fix": "inline_first,extract_when_pattern_clear",
        "severity": "medium"
      },
      "scope_creep": {
        "level": "cognitive",
        "pattern": "feature_drift,unplanned_feature_additions",
        "check": "verify_against_original_spec,requirements_traceability",
        "fix": "defer_to_backlog,separate_tickets,explicit_scope_change",
        "severity": "high"
      }
    },
    "adversarial": {
      "mode": "generate_and_challenge",
      "personas": [
        {"name": "skeptic", "lens": "questions_if_we_should_build_this_at_all", "asks": ["is_this_necessary", "what_if_we_did_nothing", "who_actually_needs_this"]},
        {"name": "minimalist", "lens": "removes_everything_possible", "asks": ["what_is_absolutely_essential", "what_can_we_delete", "simpler_alternative"]},
        {"name": "performance_zealot", "lens": "obsesses_over_every_microsecond", "asks": ["what_is_the_bottleneck", "can_we_cache_this", "what_about_at_scale"]},
        {"name": "security_auditor", "lens": "assumes_everything_is_an_attack_vector", "asks": ["how_can_this_be_exploited", "what_about_input_validation", "privilege_escalation_possible"]},
        {"name": "maintenance_dev", "lens": "thinks_about_debugging_at_3am", "asks": ["how_will_this_fail", "what_logs_do_we_need", "can_anyone_understand_this"]},
        {"name": "junior_confused", "lens": "if_they_cant_understand_it_its_too_complex", "asks": ["what_does_this_actually_do", "why_not_simpler", "where_is_the_documentation"]},
        {"name": "senior_architect", "lens": "sees_the_5_year_implications", "asks": ["how_does_this_scale", "what_about_technical_debt", "architectural_consistency"]},
        {"name": "cost_cutter", "lens": "questions_every_resource", "asks": ["what_does_this_cost", "cheaper_alternative", "roi_justification"]},
        {"name": "user_advocate", "lens": "focuses_on_actual_user_needs", "asks": ["does_user_want_this", "what_problem_does_this_solve", "user_research_done"]},
        {"name": "chaos_engineer", "lens": "tries_to_break_everything", "asks": ["what_happens_if_this_fails", "cascading_failure_possible", "graceful_degradation"]}
      ],
      "alternatives_required": 15,
      "rationale": "best_solutions_emerge_from_ideas_8_to_15_after_obvious_ones_exhausted",
      "checks": ["edge_case", "assumption_challenge", "spec_mismatch"],
      "questions": ["why_exists", "what_breaks", "simpler_available"],
      "dimensions_note": "10_personas × 15_alternatives × 3_checks = 450_challenge_dimensions"
    },
    "multi_temperature_synthesis": {
      "enabled": true,
      "temperatures": [
        {"temp": 0.1, "purpose": "deterministic,precise,by_the_book", "use_for": "security,compliance,standards"},
        {"temp": 0.5, "purpose": "balanced,practical,reasonable", "use_for": "implementation,refactoring,decisions"},
        {"temp": 0.9, "purpose": "creative,exploratory,unconventional", "use_for": "ideation,alternatives,edge_cases"}
      ],
      "synthesis": "combine_perspectives_weight_by_evidence_select_best"
    },
    "decision_gates": {
      "confidence": {
        "proceed_solo": ">0.9",
        "show_options": "0.7-0.9",
        "ask_human": "<0.7",
        "calibrate": "per_response",
        "autonomous_execution": {
          "rule": "execute_confidently_without_asking_for_obvious_improvements",
          "examples": ["formatting", "dead_code_removal", "typo_fixes", "import_cleanup", "whitespace", "consistent_naming"]
        }
      },
      "approval_chains": {
        "logic": "senior_dev→architect",
        "deletions": "author→reviewer",
        "new_features": "product→architect",
        "security": "security_team→ciso",
        "migrations": "dba→architect",
        "config": "ops→architect"
      }
    }
  },
  "quality": {
    "metrics": {
      "complexity": {
        "method": "cyclomatic",
        "formula": "branches+loops+catches+1",
        "trigger": "@result>10→simplify",
        "tool": "ast_analysis"
      },
      "coupling": {
        "method": "afferent_efferent",
        "formula": "fan_in+fan_out",
        "trigger": "@result>5→decouple",
        "includes": ["imports", "requires", "uses"]
      },
      "duplication": {
        "method": "token_similarity",
        "threshold": "@ref:constants.limits.duplication",
        "min_tokens": 50,
        "trigger": "@result>0.03→extract"
      },
      "coverage": {
        "method": "line_coverage",
        "formula": "executed/total",
        "trigger": "@result<0.8→write_tests",
        "exclude": ["comments", "whitespace", "declarations"]
      },
      "nesting": {
        "method": "depth_count",
        "trigger": "@result>4→flatten",
        "applies_to": ["json", "html", "code"]
      },
      "section_count": {
        "method": "top_level_keys",
        "trigger": "@result>16→consolidate",
        "applies_to": ["json", "yaml", "config"],
        "detection": "anti_sectionitis_principle"
      }
    },
    "smells": "@ref:standards.quality.smells.zero_new",
    "tdd": {
      "cycle": "red→green→refactor",
      "coverage_target": 0.90,
      "speed_target_ms": 100,
      "rationale": "fast_tests_enable_confidence_in_changes"
    },
    "gates": {
      "functional": {"tests": true, "coverage": "@ref:constants.limits.coverage"},
      "secure": {"vulnerabilities": 0, "input_validated": true},
      "maintainable": {
        "complexity": "@ref:constants.limits.complexity",
        "duplication": 0,
        "consolidated": "no_sectionitis"
      },
      "accessible": {
        "wcag": "AA",
        "keyboard": true,
        "semantic": "no_divitis",
        "nielsen": [
          "visibility_of_system_status",
          "match_system_and_real_world",
          "user_control_and_freedom",
          "consistency_and_standards",
          "error_prevention",
          "recognition_over_recall",
          "flexibility_and_efficiency",
          "aesthetic_and_minimalist_design",
          "help_users_recognize_diagnose_recover",
          "help_and_documentation"
        ]
      },
      "performant": {"paint_seconds": 2.5, "shift": 0.1},
      "deployable": {"health": true, "rollback": true},
      "privacy": {"gdpr": true, "pii_protected": true}
    },
    "evidence": {
      "weights": "@ref:constants.evidence_weights",
      "threshold": 1.0,
      "sources": "tests,static_analysis,complexity_checks",
      "framework_dogfooding": "master.json_validated_via_self_application_and_continuous_refactoring"
    },
    "validation": {
      "before_commit": [
        "all_tests_pass",
        "no_credentials_present",
        "master_json_compliance",
        "no_new_smells",
        "duplication_not_increased",
        "no_sectionitis_regression"
      ],
      "before_deploy": [
        "smoke_tests_pass",
        "rollback_plan_exists",
        "health_check_passing"
      ],
      "before_answering": [
        "verify_with_file_read",
        "check_command_output",
        "confirm_understanding"
      ],
      "depth": {
        "surface": {
          "checks": ["@ref_resolution", "syntax", "schema"],
          "principles": ["dry:obvious", "yagni:unused"],
          "mandatory": true
        },
        "structure": {
          "checks": ["organization", "grouping", "nesting", "wiring", "consolidation"],
          "principles": ["dry:repetition", "kiss:complexity", "solid:srp", "clarity:synonyms", "flatten:wrappers", "anti_sectionitis"],
          "mandatory": true
        },
        "philosophy": {
          "checks": ["intent", "composability", "predictability", "principle_application"],
          "principles": ["pola", "unix:do_one_thing", "orthogonal", "composition"],
          "mandatory": true
        },
        "meta": {
          "checks": ["self_application", "dogfooding", "consistency", "sharp_edge_preservation"],
          "principles": ["all_principles_applied_to_self"],
          "mandatory": true
        }
      }
    }
  },
  "workflows": {
    "new_feature": {
      "extends": "@ref:constants.workflow_defaults",
      "phases": ["discover", "analyze", "ideate", "design", "implement", "validate", "deliver", "learn"],
      "profile": "standard",
      "gates": ["functional", "secure", "maintainable"]
    },
    "bug_fix": {
      "extends": "@ref:constants.workflow_defaults",
      "phases": ["analyze", "implement", "validate", "deliver"],
      "profile": "minimal",
      "gates": ["functional", "secure"]
    },
    "refactor": {
      "extends": "@ref:constants.workflow_defaults",
      "phases": ["analyze", "design", "implement", "validate"],
      "profile": "standard",
      "gates": ["maintainable", "functional"],
      "note": "explicit_refactor_workflow_continuous_refactoring_applies_automatically_to_all_files"
    },
    "security_fix": {
      "extends": "@ref:constants.workflow_defaults",
      "phases": ["analyze", "implement", "validate", "deliver"],
      "profile": "complete",
      "gates": ["secure", "functional"],
      "priority": "highest"
    },
    "self_validation": {
      "extends": "@ref:constants.workflow_defaults",
      "phases": ["discover", "analyze", "design", "implement", "validate", "deliver", "learn"],
      "profile": "complete",
      "gates": ["functional", "secure", "maintainable", "meta"],
      "note": "applies_all_principles_to_master.json_itself_dogfooding"
    }
  },
  "standards": {
    "format": "utf8,lf,indent:2,snake_case",
    "git": {
      "commit_format": "semantic,incremental,low_churn",
      "message_structure": "type(scope): description",
      "types": ["feat", "fix", "docs", "refactor", "test", "chore"],
      "never_skip_hooks": true,
      "never_force_push_to": ["main", "master"],
      "amend_only_when": ["explicit_request", "pre_commit_hook_changes_unpushed_commit"],
      "require_branches": true,
      "protect_main": true,
      "sign_commits": true
    },
    "output": "complete,never_truncate",
    "quality": {
      "smells": {
        "zero_new": ["long_method", "god_object", "duplicate_code", "feature_envy", "divitis", "sectionitis"]
      },
      "churn": {"lock_style": 180, "batch": true},
      "beautiful": {
        "format": "automated",
        "names": "meaningful",
        "consistent": "everywhere"
      }
    },
    "platform": {
      "posix": {
        "file_ops": "cat_only,no_head_tail",
        "shell": "zsh,bash_fallback",
        "paths": "quoted,absolute_preferred",
        "line_endings": {"prefer": "unix_lf", "tools": ["tr -d '\\r'"], "avoid": ["dos2unix", "sed", "awk"]},
        "rationale": "partial_reads_miss_context_lead_to_incorrect_changes"
      },
      "openbsd": {
        "tools": "base_only,no_gnu",
        "permissions": "unveil,pledge",
        "user": "unprivileged_preferred",
        "base_system": {"included": ["nsd", "relayd", "httpd", "acme-client"], "no_pkg_add": ["nsd"]},
        "strict_mode": "set -euo pipefail",
        "note": "openbsd_sed_differs_from_linux"
      },
      "cygwin": {
        "paths": "mixed_ok,quote_required",
        "line_endings": "lf_preferred,crlf_tolerant",
        "shell": "zsh",
        "tools": "posix_subset"
      },
      "cross_platform": {
        "avoid": ["gnu_extensions", "bashisms", "head", "tail"],
        "prefer": ["cat", "awk", "sed_posix", "grep_basic"],
        "test": "bracket_double"
      }
    },
    "language_defaults": {
      "linter": true,
      "formatter": true,
      "strict": true
    },
    "languages": {
      "ruby": {
        "extends": "@ref:standards.language_defaults",
        "quotes": "double",
        "frozen": true,
        "linter": "rubocop",
        "test": "minitest"
      },
      "rails": {
        "version": 8,
        "stack": "hotwire",
        "deployment": "openbsd_native"
      },
      "javascript": {
        "extends": "@ref:standards.language_defaults",
        "quotes": "single",
        "semicolons": true,
        "const": "first",
        "linter": "eslint",
        "formatter": "prettier"
      },
      "typescript": {
        "extends": "@ref:standards.language_defaults",
        "strict": true,
        "no_any": true,
        "explicit_types": "public_apis",
        "linter": "eslint"
      },
      "shell": {
        "extends": "@ref:standards.language_defaults",
        "shell": "zsh",
        "quoted": true,
        "strict": "set -euo pipefail",
        "linter": "shellcheck"
      },
      "html": {
        "semantic": true,
        "aria": true,
        "wcag": "AA",
        "anti_divitis": "use_semantic_elements"
      },
      "css": {
        "mobile_first": true,
        "methodology": "bem",
        "properties": "logical",
        "anti_divitis": "minimize_wrappers"
      },
      "sql": {
        "parameterized": true,
        "no_dynamic": true,
        "analyze": true
      },
      "yaml": {
        "quoted_strings": true,
        "explicit_types": true,
        "linter": "yamllint",
        "anti_sectionitis": "consolidate_related_keys"
      },
      "json": {
        "anti_sectionitis": "consolidate_related_config",
        "max_nesting": 4,
        "max_sections": 16
      },
      "rust": {
        "extends": "@ref:standards.language_defaults",
        "no_unsafe": true,
        "errors": "result",
        "ownership": "explicit",
        "linter": "clippy"
      }
    },
    "security": {
      "credentials": {
        "never_log": true,
        "never_commit": true,
        "use_env_vars": true,
        "check_before_commit": ["*.key", "*.pem", "*.env", "accounts.txt"]
      },
      "destructive_ops": {
        "confirm_before": ["drop_table", "delete_prod_data", "force_push"],
        "never_assume_backup_exists": true
      }
    },
    "workflow": {
      "read_before_write": {
        "mandate": "full_file_read_required",
        "exceptions": [],
        "backups": {"default": false, "create_only_when": "explicitly_requested"},
        "overwrite_policy": "direct_overwrite_after_full_read"
      },
      "test_before_deploy": {
        "require": ["unit_tests", "integration_tests"],
        "allow_skip_with_flag": true
      },
      "incremental_changes": {
        "max_files_per_commit": 10,
        "prefer_small_diffs": true
      },
      "human_approval": [
        "logic",
        "deletions",
        "security",
        "migrations",
        "schemas",
        "api_changes"
      ],
      "auto_proceed": [
        "syntax",
        "dead_code",
        "duplication",
        "formatting",
        "imports",
        "whitespace",
        "typos"
      ]
    },
    "communication": {
      "verbosity": {
        "default": "concise",
        "elaborate_when": ["complex_task", "user_requests", "error_explanation"]
      },
      "code_explanation": {"include_only_when": "explicitly_requested"},
      "preamble": {
        "avoid": true,
        "exceptions": ["non_trivial_bash_commands", "destructive_operations"]
      }
    },
    "learning": {
      "when_corrected": {"action": "update_context", "never": "argue_or_justify"},
      "when_uncertain": {"action": "ask_clarifying_questions", "never": "guess_and_proceed"},
      "when_blocked": {
        "action": "explain_blocker_and_request_guidance",
        "never": "silently_fail_or_workaround_without_disclosure"
      }
    },
    "documentation": {
      "config_comments": {
        "style": "strunk_white_brevity",
        "tone": "casual,non_technical,natural",
        "explain": "why_not_what",
        "examples": {
          "good": ["Let SSH in, but ban anyone trying too many connections", "Tell acme-client where to get certificates", "Support live connections like chat"],
          "bad": ["Configure SSH rate limiting", "Set ACME authority URL", "Enable WebSocket protocol"]
        },
        "applies_to": ["shell_heredocs", "config_files", "inline_comments"]
      },
      "readme_structure": {
        "pattern": "vision→architecture→quick_start→prerequisites→details→troubleshooting",
        "vision": {
          "position": "first_paragraph",
          "style": "bold_visionary_statement",
          "purpose": "communicate_why_this_exists",
          "length": "1_3_sentences",
          "tone": "confident_direct_memorable",
          "examples": {
            "good": ["**Simple, secure hosting for dozens of domains on OpenBSD. One script sets up everything: TLS certificates, firewall, load balancing. No fuss.**"],
            "bad": ["This is a deployment script.", "A comprehensive infrastructure solution for OpenBSD systems."]
          }
        },
        "architecture": "ascii_diagram_showing_flow",
        "quick_start": "less_than_5_commands",
        "layout": {
          "style": "ultraminimalistic",
          "whitespace": "generous_between_sections",
          "headers": "## only (never ###)",
          "lists": "prefer_bullets_over_tables",
          "code_blocks": "always_annotated_with_comments"
        },
        "tone": "conversational,direct,approachable",
        "formatting": {
          "emphasis": "**bold** for key concepts, `code` for commands/files",
          "sections": "each ## header separated by blank line",
          "paragraphs": "single blank line between",
          "no_fluff": "avoid 'comprehensive', 'robust', 'powerful'"
        }
      },
      "visual_spacing": {
        "enabled": true,
        "scope": "config_files_not_programming_languages",
        "rule": "group_related_directives_with_blank_lines",
        "rationale": "configs_are_information_design_not_code_llm_must_apply_reasoning_to_visual_clarity",
        "applies_to": ["heredocs", "yaml", "conf_files", "ini", "toml"]
      }
    },
    "openbsd_deployment": {
      "simplified_approach": "v226_focuses_on_firewall_tls_loadbalancer",
      "skip_complexity": "no_dns_dnssec_initially",
      "certificate_strategy": "rsa_keys_for_relayd_compatibility",
      "acme_workflow": "httpd_for_challenges_only_relayd_for_https",
      "multi_domain_management": "single_account_key_loop_with_continue_on_failure",
      "failure_transparency": "document_failures_separately",
      "error_recovery": "re_read_file_before_edit_or_use_cp_or_bash_cat_heredoc",
      "dnssec_optional": {
        "install": "pkg_add ldns-utils git && git clone ldnscripts && make install",
        "algorithm": "ECDSAP256SHA256",
        "nsec": "NSEC3_SHA256",
        "validity_days": 30,
        "sign_command": "ldns-signzone -n -f zone.signed zone.unsigned keys/K*",
        "caa_records": ["issue letsencrypt.org", "issuewild letsencrypt.org", "iodef mailto:hostmaster@domain"],
        "automation": "monthly.local with ldnscript rollover",
        "reload": "pkill -HUP nsd",
        "submit_ds": "registrar requires DS record from *.ds file"
      }
    }
