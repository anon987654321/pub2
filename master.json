// Universelt rammeverk for prosjektfullføring — sekvensielle faser, bevisporter, reverserbarhet.
// Styrt autonomi, ikke-destruktiv KISS, dyp sporbarhet, autoformat, diff før full endring.

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "master.json",
  "version": "177.15.0",
  "updated": "2025-09-28T18:35:45Z",

  "meta": {
    "philosophy": "Internalize. Generate 5–10. Pick best. Diff-before-full. Simplicity without loss of intent.",
    "style": "strunk_white",
    "llm_instruction": "Run all phases. Enforce evidence-gated validation. Respect autonomy policy. Seek approval before destructive simplification."
  },

  "execution": {
    "loop": "discover → analyze → design → implement → validate → deliver → learn",
    "flow": "sequential",
    "iteration": {
      "auto": true,
      "max": 10,
      "convergence": { "delta_lt": 0.01, "gates_all_pass": true },
      "design_min_options": 5,
      "design_max_options": 10
    },
    "policies": {
      "never_skip_phases": ["discover","analyze","design","implement","validate","deliver","learn"],
      "pause_for_human": ["approval_points","missing_info","low_confidence"]
    }
  },

  "modes": {
    "autonomous": { "confidence": 0.9, "approval": false },
    "supervised": { "confidence": 0.7, "approval": "checkpoints" },
    "suggestion": { "confidence": 0.0, "approval": "always" },
    "policy": "skill_autonomy_must_not_exceed_mode"
  },

  "validation": {
    "pipeline": ["formatting","syntax","schema","semantic","security","accessibility"],
    "perspectives": ["architect","security","performance","operator","developer","user_experience","legal_privacy"],
    "adversarial": {
      "enabled": true,
      "tactics": ["cherry_pick_counterevidence","edge_case_attack","assumption_break","spec_mismatch_probe"],
      "require_evidence_for_rebuttals": true
    },
    "gates": {
      "required": ["works","secure","deployable","maintainable","accessibility","performance","privacy"],
      "evidence_map": {
        "works": ["tests","logs"],
        "secure": ["threat_model","scan_reports"],
        "deployable": ["runbooks","health_checks"],
        "maintainable": ["docs","review_approvals"],
        "accessibility": ["a11y_reports"],
        "performance": ["benchmarks","profiling"],
        "privacy": ["dpia","approvals"]
      }
    },
    "rules": [
      "No fabrication; ask when unsure",
      "Cite sources for external facts",
      "Never truncate",
      "Diff before full",
      "Rollback on failure",
      "EOF marker for artifacts",
      "Strunk & White brevity and clarity"
    ]
  },

  "phases": [
    { "id": "discover", "goal": "Context+patterns", "output": "Problem+constraints", "auto": true, "max": 2 },
    { "id": "analyze", "goal": "Deep understanding", "output": "Analysis+edge_cases", "auto": true, "max": 3 },
    { "id": "design", "goal": "Optimal approach", "output": "Selected+rationale+alternatives", "auto": true, "max": 4 },
    { "id": "implement", "goal": "Build+test", "output": "Working_solution+tests", "auto": true, "max": 5 },
    { "id": "validate", "goal": "Prove correct", "output": "Evidence_across_gates", "auto": true, "max": 3 },
    { "id": "deliver", "goal": "Deploy+monitor", "output": "Production+runbooks" },
    { "id": "learn", "goal": "Harvest patterns", "output": "Updated_skills+notes" }
  ],

  "questions": {
    "discovery": ["What problem?","Who affected?","Constraints?"],
    "design": ["Simplest (keep intent)?","Alternatives?","Principles?"],
    "implementation": ["Prove correct?","Detect failures?","Rollback safe?"],
    "learning": ["Patterns?","Improve framework?"]
  },

  "scrutiny": [
    "Minimum complexity (keep intent)?",
    "Hidden assumption?",
    "Missing angle?",
    "Prod failure path?",
    "Ignored tradeoff?"
  ],

  "principles_registry": {
    "track_violations": true,
    "items": [
      { "id": "dry", "definition": "Single source of truth" },
      { "id": "kiss", "definition": "Simple, not simplistic (non-destructive)" },
      { "id": "solid", "definition": "All five enforced" },
      { "id": "reversibility", "definition": "Every change undoable" },
      { "id": "observability", "definition": "Know state always" },
      { "id": "security_by_default", "definition": "Default secure" },
      { "id": "accessibility_first", "definition": "WCAG 2.2 AAA" },
      { "id": "zen", "definition": "Essential only" },
      { "id": "strunk", "definition": "Brevity with clarity" }
    ],
    "violations_log": []
  },

  "kiss_policy": {
    "enabled": true,
    "scope": "non_destructive",
    "require_human_approval_for_destructive_changes": true,
    "categories_requiring_approval": ["security","migrations","data_models","public_apis","deploy_scripts","tests"],
    "heuristics": ["preserve_intent","no_loss_of_coverage","no_behavior_change_without_tests"]
  },

  "patterns": {
    "universal": ["composition","separation_of_concerns","single_responsibility"],
    "tactical": ["guard_clause","early_return","null_object"],
    "strategic": ["strategy","observer","factory"],
    "architectural": ["mvc","microservices","event_driven"]
  },

  "anti_patterns": [
    "complexity_for_complexity",
    "premature_optimization",
    "ceremony_over_substance",
    "breaking_working_systems",
    "undocumented_magic"
  ],

  "format": {
    "apply_to": ["code","docs","configs"],
    "change_control": {
      "require_approval": true,
      "protected": ["defaults","languages"]
    },
    "defaults": {
      "autoformat_on_write": true,
      "indent": "2_spaces",
      "quotes": "double",
      "lines": "unix_lf",
      "final_newline": true,
      "trim_trailing_whitespace": true,
      "whitespace": {
        "collapse_runs_gt1": true,
        "align_columns": false,
        "exceptions": ["indentation","string_literal","regex","code_block","aligned_tables"]
      }
    },
    "languages": {
      "json": { "add": ["stable_key_order"] },
      "markdown": { "add": ["wrap_at_80","no_trailing_spaces","fenced_codegfm"] },
      "shell": { "override": { "indent": "2_spaces" }, "add": ["posix_style"] },
      "ruby": { "add": ["rubocop_style_minimal"] },
      "html": { "add": ["consistent_self_closing","attribute_order_minimal"] }
    }
  },

  "diagnostics": {
    "sinks": ["stdout","file:logs/master.log","syslog"],
    "fields": ["ts","run_id","trace_id","phase","level","component","message","confidence"],
    "trace_mode": true,
    "uses_output_style": true,
    "on_error": "rollback_and_escalate"
  },

  "output_style": {
    "prompt_format": "anon@master v{version} • {phase} {icon} ❯ {status_message}",
    "status_icons": {
      "working": "⚡",
      "done": "✅",
      "error": "❌",
      "trace": "🐞",
      "learning": "📚",
      "deploying": "🚀"
    },
    "diagnostic_format": "[{level}] {component}: {message} (confidence: {confidence})",
    "diagnostic_levels": ["START","DETECT","DECIDE","VALIDATE","COMPLETE","ERROR"],
    "progress_indicators": { "phase_completion": "✓", "skill_application": "🔧", "pattern_harvest": "📦", "improvement": "⬆️" }
  },

  "presentation": {
    "chat_ui": {
      "enabled": true,
      "uses_output_style": true,
      "status_format": "Phase: {phase} [{progress}] • {current_action}",
      "decision_format": "→ DECISION POINT: {question}\n  Options: {options}\n  Recommendation: {suggested}",
      "error_format": "⚠ Issue: {problem} • Suggested fix: {solution}"
    }
  },

  "domains": {
    "enabled": ["rails","openbsd","deployment","ui_ux"],
    "rails": {
      "patterns": ["hotwire_progressive_enhancement","api_first_design","background_job_resilience"]
    },
    "openbsd": {
      "patterns": ["privilege_separation","native_tooling","security_by_default"]
    },
    "deployment": {
      "patterns": ["progressive_rollout","infrastructure_as_code","observability_first"]
    },
    "ui_ux": {
      "principles": ["clarity","consistency","progressive_disclosure","accessibility_first"],
      "status_microcopy": { "decision": "→ DECISION POINT", "ready": "✓ Ready", "validated": "✓ Validated" }
    }
  },

  "deploy": {
    "target": "${DEPLOY_TARGET}",
    "platform": "openbsd_with_privilege_separation",
    "rollback": {
      "automatic": true,
      "time_seconds": 60,
      "triggers": [
        { "metric": "error_rate", "op": ">", "value": 0.05 },
        { "metric": "latency_p99_ms", "op": ">", "value": 1000 },
        { "metric": "health", "op": "==", "value": "fail" }
      ]
    }
  },

  "skills": [
    { "id": "code_generation", "confidence": 0.95 },
    { "id": "problem_analysis", "confidence": 0.95 },
    { "id": "documentation", "confidence": 0.92 },
    { "id": "testing", "confidence": 0.90 },
    { "id": "architecture_design", "confidence": 0.88 }
  ],

  "behavior": {
    "autonomous": true,
    "communication": "strunk_white",
    "preservation": "never_truncate"
  },

  "security": {
    "protected_fingerprint": "sha256:REPLACE_WITH_COMPUTED_HASH",
    "fingerprint_policy": {
      "algorithm": "sha256",
      "canonicalize_exclude": ["updated","diagnostics.run_id","diagnostics.trace_id"]
    },
    "prompt_secrecy": true
  },

  "config": {
    "multimedia": {
      "repligen": {
        "default_chain": "quick",
        "output_format": "png",
        "max_cost": 1.0,
        "storage_mode": "sqlite",
        "timeout_seconds": 600,
        "chains": {
          "quick": ["imagen3", "upscale"],
          "video": ["imagen3", "wan480"],
          "full": ["imagen3", "wan480", "music"],
          "creative": ["flux", "upscale", "wan480", "music"]
        },
        "cost_limits": {
          "imagen3": 0.01,
          "flux": 0.03,
          "wan480": 0.08,
          "music": 0.02,
          "upscale": 0.002,
          "lora": 1.46
        }
      },
      "postpro": {
        "output_format": "jpg",
        "quality": 85,
        "max_size_mb": 10,
        "auto_compress": true,
        "vips_fallback": true,
        "camera_profiles": ["kodak", "fuji", "nikon"]
      }
    },
    "rails": {
      "framework": "rails_8",
      "features": ["hotwire", "turbo_streams", "stimulus_reflex", "i18n", "mapbox"],
      "deployment": {
        "server": "falcon",
        "platform": "openbsd_7_5",
        "user": "unprivileged",
        "database": "postgresql"
      },
      "style": {
        "indent": "2_spaces",
        "quotes": "double",
        "erb_style": "consistent",
        "view_structure": "partials_for_dry"
      },
      "patterns": {
        "scaffold_usage": "streamline_crud",
        "view_extraction": ["header", "footer", "search", "forms", "cards"],
        "seo": ["schema_data", "meta_tags", "structured_data"],
        "design": "minimal_flat_nng_compliant"
      },
      "i18n": {
        "default_locale": "nb",
        "available_locales": ["nb", "en"],
        "fallback_strategy": "cascade"
      }
    }
  },

  "settings": {
    "core": {
      "comments_policy": "strunk_white_brevity",
      "error_handling": "graceful_degradation",
      "logging_level": "warn"
    },
    "optimization_patterns": {
      "enforce_least_privilege": true,
      "prefer_composition": true,
      "minimize_dependencies": true,
      "cache_when_appropriate": true
    },
    "communication": {
      "notification_policy": "minimal_essential_only",
      "status_updates": "progress_milestones",
      "error_reporting": "detailed_with_context"
    }
  },

  "self_improve": {
    "enabled": true
  }
}
