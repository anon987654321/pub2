        "bodo.no", "arendal.no", "haugesund.no", "hamar.no", "larvik.no",
        "halden.no", "kongsberg.no", "molde.no", "harstad.no", "horten.no",
        "gjovik.no", "lillestrom.no", "mo.no", "egersund.no", "svolvaer.no",
        "alesund.no", "trondheim.no"
