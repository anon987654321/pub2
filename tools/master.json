        ],
        "script_standards": [
          "#!/usr/bin/env zsh",
          "set -euo pipefail",
          "local_variables",
          "modular_functions"
        ]
      }
    }
  },
  "file_priorities": {
    "critical": [
      "ai3/**/*.rb",
      "rails/**/*.rb",
      "cognitive_*.rb",
      "consolidation_*.rb"
    ],
    "high": [
