    "medium": [
      "**/*.js",
      "**/*.json"
    ],
    "low": [
      "**/*.md",
      "**/*.txt"
    ]
  },
  "consumers": {
    "principle_audit": [
      "knowledge_base.pattern_library"
    ]
  }
}
