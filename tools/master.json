        "avoid_loops": true
      },
      "reanalysis_policy": {
        "auto_deepen_on_uncertainty": true,
        "uncertainty_threshold": 0.15,
        "expand_search_space_on_failure": true
      },
      "user_notification_policy": {
        "ask_only_on_decision_boundaries": true,
        "boundaries": [
          "scope_change",
          "feature_addition",
          "risk_above_threshold",
          "file_operations",
          "language_introduction",
          "normalization",
          "cross_reference_analysis",
          "stack_declaration"
        ]
      }
    },
    "adversarial_qna": {
      "enabled": true,
      "modes": [
        "self_critique",
        "red_team",
        "socratic"
      ],
      "min_alternatives": 3,
      "scorers": [
        "security",
        "accessibility",
        "performance",
        "maintainability"
      ],
      "selection": "score_then_cherrypick_best"
    },
    "ensemble_decision": {
      "multi_perspective_ref": "/core/multi_perspective",
      "consensus": "weighted_vote",
      "tie_breaker": "architect"
    },
    "iteration_policy": {
      "auto_iterate": "per_phase_until_plateau",
      "max_iterations_per_phase": 5,
      "improvement_threshold_percent": 5,
      "improvement_calc": "percent_reduction_in_violations",
      "early_exit_on_plateau": true,
      "hard_cap_total_iterations": 12
    },
    "sanity_checks": {
      "non_empty_checks_required": true,
      "validate_every_check_has_pattern_or_method": true,
      "disallow_unknown_keys": true
    },
    "state": {
      "repo_state_hash": "sha256(all_file_paths+contents+config_version)"
    },
    "self_run": {
      "enabled": true,
      "scope": [
        "self"
      ],
      "audits": [
        "principles_full"
      ],
      "equivalence_contract": true
    },
    "scheduler": {
      "scheduled_audit_cron": "0 3 * * 1"
    },
    "stack_selection": {
      "mode": "ask_user_when_needed",
      "ask_prompt": "Which stacks apply to this repository (e.g., rails, node, frontend, shell, openbsd)? You can list multiple.",
      "triggers": [
        "apply_if_stack_reference_detected",
        "stack_specific_rule_encountered",
        "ambiguous_environment"
      ],
      "remember_choice_for_session": true,
      "active_stacks": [
        "frontend"
      ]
    }
  },
  "interface": {
    "message_prefix": {
      "enabled": false,
      "pattern": "**master.json v${meta.version} (GitHub Copilot)**",
      "enforcement": "prepend_all_responses"
    },
    "output_validation": {
      "completeness_checks": [
        "all_clusters_represented",
        "all_phases_covered",
        "metrics_defined",
        "risks_identified"
      ],
      "consistency_verification": [
        "terminology_alignment",
        "cross_reference_integrity",
        "decision_traceability",
        "measurement_continuity"
      ],
      "stakeholder_alignment": [
        "requirement_coverage_verified",
        "acceptance_criteria_met",
        "risk_acknowledgment_documented",
        "success_metrics_agreed"
      ],
      "content_integrity_checks": "no_placeholders_and_exact_user_content",
      "required_sections": [
        "interpreters",
        "execution.embedded_linters",
        "execution.principle_audit",
        "review_workflow",
        "measurement.primary_metrics"
      ],
      "prohibit_deletions_of": [
        "/interpreters",
        "/execution/embedded_linters",
        "/execution/principle_audit",
        "/review_workflow",
        "/measurement/primary_metrics"
      ]
    },
    "human_readability": {
      "line_width": 120,
      "indent_spaces": 2,
      "max_nesting": 6,
      "prefer_explicit_structures": true,
      "disable_obfuscation": true
    },
    "trace_presentation": {
      "mode": "syslog",
      "show_technical_details": true,
      "group_by_phase": true
    }
  },
  "interpreters": {
    "javascript": {
      "persona": "eslint_strict",
      "rules": [
        "2_space_indentation",
        "semicolons_required",
        "const_let_preferred",
        "arrow_functions"
      ],
      "engine_ref": "/execution/embedded_linters/engines/javascript"
    },
    "ruby": {
      "persona": "rubocop",
      "rules": [
        "2_space_indentation",
        "snake_case_naming",
        "single_quotes_preferred",
        "guard_clauses"
      ],
      "engine_ref": "/execution/embedded_linters/engines/ruby"
    },
    "css": {
      "persona": "flat_design_engineer",
      "rules": [
        "expanded_blocks_no_oneline_rules",
        "group_related_rules_together"
      ],
      "engine_ref": "/execution/embedded_linters/engines/css"
    },
    "shell": {
      "persona": "shellcheck_strict",
      "rules": [
        "set_euopipefail",
        "quote_vars",
        "prefer_command_substitution"
      ],
      "engine_ref": "/execution/embedded_linters/engines/shell"
    },
    "html": {
      "persona": "html_audit",
      "rules": [
        "no_inline_event_handlers",
        "no_document_write",
        "no_deprecated_tags"
      ],
      "engine_ref": "/execution/embedded_linters/engines/html"
    },
    "markdown": {
      "persona": "md_lint",
      "rules": [
        "heading_increment",
        "line_length_120",
        "no_trailing_spaces"
      ],
      "engine_ref": "/execution/embedded_linters/engines/markdown"
    }
  },
  "knowledge_base": {
    "pattern_library": {
      "successful_implementations": "anonymized_case_studies_with_outcome_metrics_and_user_context",
      "failure_modes": "anti_patterns_with_prevention_strategies_and_recovery_protocols",
      "optimization_techniques": "proven_refinements_with_applicability_criteria_and_measurement_validation",
      "user_adaptation_patterns": "communication_style_matching_technical_depth_calibration_and_context_awareness"
    }
  },
  "standards": {
    "accessibility": {
      "apply_if_stack": [
        "frontend"
      ],
      "wcag_standard": "WCAG_2_2_AAA",
      "contrast_minimum": "4.5:1",
      "contrast_enhanced": "7:1",
      "font_minimum": "16px",
      "line_height_minimum": "1.5",
      "touch_target_minimum": "44px",
      "aria_requirement": "comprehensive_and_semantic",
      "heading_structure": "logical_and_sequential",
      "focus_indicators": "high_contrast_and_visible",
      "exempt_decorative_text": true,
      "enforce_on": "essential_elements_only"
    },
    "performance": {
      "apply_if_stack": [
        "frontend"
      ],
      "core_web_vitals": {
        "lcp_threshold": "≤2500ms",
        "lcp_target": "1500ms",
        "fid_threshold": "≤100ms",
        "fid_target": "50ms",
        "cls_threshold": "≤0.1",
        "cls_target": "0.05"
      }
    },
    "security": {
      "headers_required": [
        "content_security_policy",
        "strict_transport_security",
        "x_frame_options"
      ],
      "architecture": "zero_trust",
      "access_control": "least_privilege_rbac",
      "encryption": "rest_transit_key_rotation",
      "injection_prevention": "parameterized_queries_mandatory"
    },
    "seo": {
      "apply_if_stack": [
        "frontend"
      ],
      "require_canonical": false,
      "require_meta_viewport": true,
      "structured_data_jsonld": true,
      "sitemap_xml_required": true,
      "robots_txt_recommended": true,
      "hreflang_for_i18n": true,
      "open_graph_tags": true,
      "twitter_card_tags": true
    },
    "tech_stack": {
      "ruby_rails": {
        "rails_8_plus": [
          "stimulus_hotwire",
          "turbo_drive",
          "solid_queue"
        ],
        "conventions": [
          "snake_case",
          "yard_docs",
          "guard_clauses"
        ]
      },
      "openbsd": {
        "apply_if_stack": [
          "openbsd"
        ],
        "principles": [
          "principle_of_least_privilege",
          "privilege_separation",
          "pledge_unveil",
          "default_deny"
        ]
      },
      "zsh": {
        "apply_if_stack": [
